# Copy to .env (gitignored). Never commit real values.

# Tinker API key. Claim the credit first: https://hacktoberfest.com/my/promos
# Key page: https://tinker-console.thinkingmachines.ai/
TINKER_API_KEY=
# Set after SFT: tinker://.../sampler_weights/...  (empty = base Qwen/Qwen3-8B)
ONEBAR_MODEL=

# Temporal. Local dev: localhost:7233 / default / no key.
# Cloud trial (optional): https://cloud.temporal.io/
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Dedicated Gmail for the ask@ inbox. Turn on 2-step verification, then create an app password:
# https://myaccount.google.com/apppasswords   (IMAP is on by default in current Gmail)
IMAP_USER=
IMAP_APP_PASSWORD=

# Twilio (stretch, SMS to your own verified number only): https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Later: Hugging Face write token for the adapter export: https://huggingface.co/settings/tokens
HF_TOKEN=
# Later: DigitalOcean token for the droplet: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=
